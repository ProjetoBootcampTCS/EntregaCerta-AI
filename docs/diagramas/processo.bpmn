<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_EntregaCerta" targetNamespace="https://entregacerta.local/process" exporter="EntregaCerta planning tools" exporterVersion="0.2.0">
  <bpmn:error id="Error_GenAIUnavailable" name="GenAI indisponível" errorCode="GENAI_UNAVAILABLE" />
  <bpmn:process id="Process_EntregaCerta" name="Acompanhar risco de atraso" isExecutable="false">
    <bpmn:documentation>Processo documental do protótipo. A fila apoia revisão humana; indisponibilidade da API não impede inferência nem consulta. Não representa automação de contato com transportadoras.</bpmn:documentation>
    <bpmn:laneSet id="Lanes">
      <bpmn:lane id="Lane_App" name="EntregaCerta AI">
        <bpmn:flowNodeRef>Start_Approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LoadFacts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DataValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Score</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InQueue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Monitor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GenAI</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GenAIError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Factual</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Analyst" name="Analista de operações">
        <bpmn:flowNodeRef>DataIssue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_DataIssue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RegisterDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReportChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WantReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CheckReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Approved" name="Pedido aprovado">
      <bpmn:outgoing>F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="LoadFacts" name="Consultar dados disponíveis na aprovação">
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="DataValid" name="Dados necessários válidos?" default="F04">
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
      <bpmn:outgoing>F04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="DataIssue" name="Registrar pendência de dados">
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:outgoing>F05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_DataIssue" name="Aguardando correção">
      <bpmn:incoming>F05</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Score" name="Calcular escore e registrar versão">
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:outgoing>F06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="InQueue" name="Na fila prioritária?" default="F07">
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:outgoing>F07</bpmn:outgoing>
      <bpmn:outgoing>F08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Monitor" name="Registrar monitoramento padrão">
      <bpmn:incoming>F07</bpmn:incoming>
      <bpmn:outgoing>F09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Review" name="Revisar pedido e evidências">
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="RegisterDecision" name="Registrar decisão de acompanhamento">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Merge">
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="ReportChoice" name="Escolher se deseja relatório">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="WantReport" name="Relatório solicitado?" default="F15">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="GenAI" name="Gerar relatório fundamentado por API">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="GenAIError" name="API indisponível" attachedToRef="GenAI" cancelActivity="true">
      <bpmn:outgoing>F17</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDefinition_GenAI" errorRef="Error_GenAIUnavailable" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Factual" name="Preparar resumo factual e aviso de indisponibilidade">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="CheckReport" name="Conferir e salvar relatório">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Done" name="Caso registrado">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:incoming>F19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F01" sourceRef="Start_Approved" targetRef="LoadFacts" />
    <bpmn:sequenceFlow id="F02" sourceRef="LoadFacts" targetRef="DataValid" />
    <bpmn:sequenceFlow id="F03" sourceRef="DataValid" targetRef="Score" name="Sim">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">dados_validos</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F04" sourceRef="DataValid" targetRef="DataIssue" name="Não" />
    <bpmn:sequenceFlow id="F05" sourceRef="DataIssue" targetRef="End_DataIssue" />
    <bpmn:sequenceFlow id="F06" sourceRef="Score" targetRef="InQueue" />
    <bpmn:sequenceFlow id="F07" sourceRef="InQueue" targetRef="Monitor" name="Não" />
    <bpmn:sequenceFlow id="F08" sourceRef="InQueue" targetRef="Review" name="Sim">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">pedido_prioritario</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F09" sourceRef="Monitor" targetRef="Merge" />
    <bpmn:sequenceFlow id="F10" sourceRef="Review" targetRef="RegisterDecision" />
    <bpmn:sequenceFlow id="F11" sourceRef="RegisterDecision" targetRef="Merge" />
    <bpmn:sequenceFlow id="F12" sourceRef="Merge" targetRef="ReportChoice" />
    <bpmn:sequenceFlow id="F13" sourceRef="ReportChoice" targetRef="WantReport" />
    <bpmn:sequenceFlow id="F14" sourceRef="WantReport" targetRef="GenAI" name="Sim">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">relatorio_solicitado</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F15" sourceRef="WantReport" targetRef="End_Done" name="Não" />
    <bpmn:sequenceFlow id="F16" sourceRef="GenAI" targetRef="CheckReport" />
    <bpmn:sequenceFlow id="F17" sourceRef="GenAIError" targetRef="Factual" />
    <bpmn:sequenceFlow id="F18" sourceRef="Factual" targetRef="CheckReport" />
    <bpmn:sequenceFlow id="F19" sourceRef="CheckReport" targetRef="End_Done" />
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_EntregaCerta">
    <bpmn:participant id="Participant_EntregaCerta" name="EntregaCerta AI · acompanhamento de pedidos" processRef="Process_EntregaCerta" />
  </bpmn:collaboration>
