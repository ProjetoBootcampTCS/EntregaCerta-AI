# Copiar para .env e preencher localmente. Nunca versionar senhas ou chaves.
# Opcional: quando preenchida, substitui POSTGRES_* na conexão Python.
ENTREGACERTA_DATABASE_URL=

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=admin
POSTGRES_PASSWORD=preencha_uma_senha_local
POSTGRES_DB=meu_banco

GEMINI_API_KEY=
# Modelo usado pelo código atual; confirme disponibilidade para sua chave.
GEMINI_MODEL=gemini-3.1-flash-lite

# Sessões web: false somente em localhost HTTP; true em produção HTTPS.
ENTREGACERTA_COOKIE_SECURE=false
# Origens exatas autorizadas para login, cadastro e ações autenticadas.
ENTREGACERTA_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
